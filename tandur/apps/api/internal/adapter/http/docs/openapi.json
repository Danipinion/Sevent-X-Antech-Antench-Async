{
  "openapi": "3.0.3",
  "info": {
    "title": "TANDUR API",
    "version": "1.0.0",
    "description": "Spesifikasi REST API TANDUR sebagai kontrak komunikasi antara Frontend dan Backend. Mendukung operasional rantai pasok komoditas pertanian, agregasi stok petani, dan mekanisme kontrol margin harga.\n"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api/v1",
      "description": "Development Server Local"
    },
    {
      "url": "/api/v1",
      "description": "Traefik Proxy Path"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Healthcheck Status Server",
        "description": "Memeriksa ketersediaan API backend dan koneksi database.",
        "responses": {
          "200": {
            "description": "Server beroperasi normal",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Server beroperasi normal"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "service": {
                          "type": "string",
                          "example": "tandur-api"
                        },
                        "version": {
                          "type": "string",
                          "example": "v1.0.0"
                        },
                        "database": {
                          "type": "string",
                          "example": "connected"
                        },
                        "timestamp": {
                          "type": "string",
                          "example": "2026-11-21T09:30:00Z"
                        }
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/commodities": {
      "get": {
        "summary": "Daftar Seluruh Komoditas",
        "description": "Mengambil daftar komoditas pertanian beserta acuan harga dasar dan harga pasar.",
        "responses": {
          "200": {
            "description": "Berhasil mengambil daftar komoditas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Daftar komoditas berhasil diambil"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Commodity"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/commodities/{id}": {
      "get": {
        "summary": "Detail Komoditas",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detail komoditas ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Detail komoditas berhasil diambil"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Commodity"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Komoditas tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Registrasi Akun Pengguna Baru",
        "description": "Mendaftarkan akun baru (farmer, middleman, atau buyer) beserta informasi lokasi opsional. Anda dapat mengisi langsung melalui Form Input di bagian **Parameters** di bawah ini, atau memilih contoh JSON melalui **Request body**.\n",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "Nama lengkap pengguna (Wajib)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "Pak Joko Tani"
            }
          },
          {
            "name": "phone",
            "in": "query",
            "description": "Nomor Handphone 10-13 digit (Wajib)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "081234567890"
            }
          },
          {
            "name": "password",
            "in": "query",
            "description": "Password minimal 6 karakter (Wajib)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "password",
              "example": "rahasia123"
            }
          },
          {
            "name": "role",
            "in": "query",
            "description": "Peran akun dalam sistem (Wajib)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "farmer",
                "middleman",
                "buyer"
              ],
              "example": "farmer"
            }
          },
          {
            "name": "nik",
            "in": "query",
            "description": "NIK KTP 16 digit angka (Opsional)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "3201010101010077"
            }
          },
          {
            "name": "is_bisnis",
            "in": "query",
            "description": "Apakah akun bisnis / perusahaan",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "example": false
            }
          },
          {
            "name": "address",
            "in": "query",
            "description": "Alamat lokasi kebun / gudang / toko (Opsional)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "Jl. Pertanian Makmur No. 20"
            }
          },
          {
            "name": "latitude",
            "in": "query",
            "description": "Titik koordinat Latitude (Opsional)",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "example": -6.7456
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "description": "Titik koordinat Longitude (Opsional)",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "example": 107.0872
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "examples": {
                "petani_lengkap": {
                  "summary": "\ud83e\uddd1\u200d\ud83c\udf3e 1. Petani (Lengkap dengan Koordinat Kebun)",
                  "value": {
                    "nik": "3201010101010099",
                    "name": "Pak Slamet Petani",
                    "phone": "081399998888",
                    "password": "secretPassword123",
                    "role": "farmer",
                    "is_bisnis": false,
                    "location": {
                      "label": "Kebun Cabai Utama",
                      "address": "Jl. Raya Pertanian No. 12",
                      "village": "Cikanyere",
                      "district": "Sukaresmi",
                      "city": "Kabupaten Cianjur",
                      "province": "Jawa Barat",
                      "latitude": -6.7456,
                      "longitude": 107.0872
                    }
                  }
                },
                "tengkulak_bisnis": {
                  "summary": "\ud83c\udfe2 2. Tengkulak (Akun Bisnis + Gudang)",
                  "value": {
                    "nik": "3201010101010088",
                    "name": "CV Tani Berkah Bersama",
                    "phone": "081288887777",
                    "password": "secretPassword123",
                    "role": "middleman",
                    "is_bisnis": true,
                    "location": {
                      "label": "Gudang Konsolidasi",
                      "address": "Jl. Pergudangan Agrobisnis No. 8",
                      "village": "Sukamaju",
                      "district": "Cianjur",
                      "city": "Kabupaten Cianjur",
                      "province": "Jawa Barat",
                      "latitude": -6.8173,
                      "longitude": 107.1394
                    }
                  }
                },
                "pembeli_individu": {
                  "summary": "\ud83d\uded2 3. Pembeli (Simple tanpa Lokasi)",
                  "value": {
                    "name": "Resto Padang Sejahtera",
                    "phone": "081177776666",
                    "password": "secretPassword123",
                    "role": "buyer",
                    "is_bisnis": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Berhasil mendaftar",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Registrasi akun berhasil"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Data masukan tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Nomor handphone atau NIK sudah terdaftar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login Pengguna",
        "description": "Autentikasi pengguna menggunakan Nomor Handphone atau NIK sebagai username dan password. Mengembalikan token sesi berbasis JWT (JSON Web Token) yang digunakan untuk otorisasi endpoint terlindungi. Anda dapat mengisi langsung melalui Form Input di bagian **Parameters** di bawah ini, atau mengirim JSON payload melalui **Request body**.\n",
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "description": "Nomor Handphone (10-13 digit) atau NIK (16 digit angka)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "081399998888"
            }
          },
          {
            "name": "password",
            "in": "query",
            "description": "Password akun pengguna",
            "required": false,
            "schema": {
              "type": "string",
              "format": "password",
              "example": "secretPassword123"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "examples": {
                "login_phone": {
                  "summary": "\ud83d\udcf1 1. Login menggunakan Nomor Handphone",
                  "value": {
                    "username": "081399998888",
                    "password": "secretPassword123"
                  }
                },
                "login_nik": {
                  "summary": "\ud83e\udeaa 2. Login menggunakan NIK KTP",
                  "value": {
                    "username": "3201010101010099",
                    "password": "secretPassword123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login berhasil, token JWT diterbitkan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Login berhasil"
                    },
                    "data": {
                      "$ref": "#/components/schemas/LoginResponseData"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Username atau password tidak diisi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Kredensial tidak valid (Nomor HP/NIK atau password salah)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Akun tidak aktif atau dinonaktifkan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Profil Pengguna Aktif (Sesi JWT)",
        "description": "Mengambil data profil pengguna yang saat ini sedang login berdasarkan token JWT di header Authorization.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profil pengguna berhasil diambil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Profil pengguna berhasil diambil"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token otorisasi tidak valid atau telah kedaluwarsa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Pengguna tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Masukkan token JWT yang diperoleh dari endpoint /auth/login"
      }
    },
    "schemas": {
      "Commodity": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "unit",
          "base_price",
          "current_market_price"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "cabai-merah"
          },
          "name": {
            "type": "string",
            "example": "Cabai Merah Keriting"
          },
          "category": {
            "type": "string",
            "example": "Hortikultura"
          },
          "unit": {
            "type": "string",
            "example": "kg"
          },
          "base_price": {
            "type": "number",
            "format": "float",
            "example": 40000
          },
          "current_market_price": {
            "type": "number",
            "format": "float",
            "example": 45000
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "status",
          "error",
          "meta"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "meta": {
            "$ref": "#/components/schemas/ErrorMeta"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_CREDENTIALS",
            "description": "Kode error unik huruf kapital standar"
          },
          "message": {
            "type": "string",
            "example": "Nomor HP/NIK atau password salah",
            "description": "Deskripsi pesan error"
          }
        }
      },
      "ErrorMeta": {
        "type": "object",
        "required": [
          "trace"
        ],
        "properties": {
          "trace": {
            "$ref": "#/components/schemas/TraceMeta"
          }
        }
      },
      "Meta": {
        "type": "object",
        "required": [
          "trace"
        ],
        "properties": {
          "trace": {
            "$ref": "#/components/schemas/TraceMeta"
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        }
      },
      "TraceMeta": {
        "type": "object",
        "required": [
          "request_id",
          "trace_id",
          "timestamp"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "example": "req_8f92a3b4-1c2d-4e5f-9a8b-7c6d5e4f3a2b"
          },
          "correlation_id": {
            "type": "string",
            "example": "corr_11223344-5566-7788-99aa-bbccddeeff00"
          },
          "trace_id": {
            "type": "string",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736"
          },
          "span_id": {
            "type": "string",
            "example": "00f067aa0ba902b7"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-21T02:31:00.123Z"
          },
          "api_version": {
            "type": "string",
            "example": "v1.0.0"
          },
          "processing_time_ms": {
            "type": "integer",
            "example": 42
          },
          "service_node": {
            "type": "string",
            "example": "tandur-api-dev"
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "required": [
          "page",
          "per_page",
          "total_items",
          "total_pages",
          "has_next",
          "has_prev"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "per_page": {
            "type": "integer",
            "example": 20
          },
          "total_items": {
            "type": "integer",
            "example": 478
          },
          "total_pages": {
            "type": "integer",
            "example": 24
          },
          "has_next": {
            "type": "boolean",
            "example": true
          },
          "has_prev": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "Inventory": {
        "type": "object",
        "required": [
          "id",
          "commodity_id",
          "owner_id",
          "quantity",
          "unit",
          "quality_grade",
          "location_name",
          "latitude",
          "longitude",
          "harvest_date"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "inv-001"
          },
          "commodity_id": {
            "type": "string",
            "example": "cabai-merah"
          },
          "owner_id": {
            "type": "string",
            "example": "usr-petani-001"
          },
          "quantity": {
            "type": "number",
            "format": "float",
            "example": 500
          },
          "unit": {
            "type": "string",
            "example": "kg"
          },
          "quality_grade": {
            "type": "string",
            "enum": [
              "GRADE_A",
              "GRADE_B",
              "GRADE_C"
            ],
            "example": "GRADE_A"
          },
          "location_name": {
            "type": "string",
            "example": "Cikajang, Garut"
          },
          "latitude": {
            "type": "number",
            "format": "float",
            "example": -7.3486
          },
          "longitude": {
            "type": "number",
            "format": "float",
            "example": 107.8184
          },
          "harvest_date": {
            "type": "string",
            "format": "date",
            "example": "2026-11-14"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "e445499d-4f26-424c-9e70-10ffcc8b2a35"
          },
          "nik": {
            "type": "string",
            "nullable": true,
            "maxLength": 16,
            "example": "3201010101010099"
          },
          "name": {
            "type": "string",
            "maxLength": 150,
            "example": "Pak Slamet Petani"
          },
          "phone": {
            "type": "string",
            "maxLength": 13,
            "example": "081399998888"
          },
          "role": {
            "type": "string",
            "enum": [
              "farmer",
              "middleman",
              "buyer"
            ],
            "example": "farmer"
          },
          "is_bisnis": {
            "type": "boolean",
            "default": false,
            "example": false
          },
          "is_active": {
            "type": "boolean",
            "default": true,
            "example": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-19T18:10:18Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-19T18:10:18Z"
          },
          "location": {
            "$ref": "#/components/schemas/UserLocation"
          }
        }
      },
      "UserLocation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "562e7d5c-d1af-42d6-b64d-858c49e28b8d"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "example": "e445499d-4f26-424c-9e70-10ffcc8b2a35"
          },
          "label": {
            "type": "string",
            "example": "Kebun Cabai Utama"
          },
          "address": {
            "type": "string",
            "example": "Jl. Raya Pertanian No. 12"
          },
          "village": {
            "type": "string",
            "example": "Cikanyere"
          },
          "district": {
            "type": "string",
            "example": "Sukaresmi"
          },
          "city": {
            "type": "string",
            "example": "Kabupaten Cianjur"
          },
          "province": {
            "type": "string",
            "example": "Jawa Barat"
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "example": -6.7456
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "example": 107.0872
          },
          "is_primary": {
            "type": "boolean",
            "example": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "name",
          "phone",
          "password",
          "role"
        ],
        "properties": {
          "nik": {
            "type": "string",
            "maxLength": 16,
            "example": "3201010101010099"
          },
          "name": {
            "type": "string",
            "maxLength": 150,
            "example": "Pak Slamet Petani"
          },
          "phone": {
            "type": "string",
            "maxLength": 13,
            "example": "081399998888"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "format": "password",
            "example": "secretPassword123"
          },
          "role": {
            "type": "string",
            "enum": [
              "farmer",
              "middleman",
              "buyer"
            ],
            "example": "farmer"
          },
          "is_bisnis": {
            "type": "boolean",
            "default": false,
            "example": false
          },
          "location": {
            "type": "object",
            "required": [
              "address",
              "latitude",
              "longitude"
            ],
            "properties": {
              "label": {
                "type": "string",
                "example": "Kebun Cabai Utama"
              },
              "address": {
                "type": "string",
                "example": "Jl. Raya Pertanian No. 12"
              },
              "village": {
                "type": "string",
                "example": "Cikanyere"
              },
              "district": {
                "type": "string",
                "example": "Sukaresmi"
              },
              "city": {
                "type": "string",
                "example": "Kabupaten Cianjur"
              },
              "province": {
                "type": "string",
                "example": "Jawa Barat"
              },
              "latitude": {
                "type": "number",
                "format": "double",
                "example": -6.7456
              },
              "longitude": {
                "type": "number",
                "format": "double",
                "example": 107.0872
              }
            }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "description": "Nomor Handphone (10-13 digit) atau NIK (16 digit angka)",
            "example": "081399998888"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "Password akun pengguna",
            "example": "secretPassword123"
          }
        }
      },
      "LoginResponseData": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JSON Web Token (JWT) untuk autentikasi sesi",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-23T15:30:00Z"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      }
    }
  }
}